  "state": "open",
  "locked": false,
  "title": "fix(client): count opponents correctly when the local seat is eliminated",
  "user": {
    "login": "jeffrey701",
    "id": 158072326,
    "node_id": "U_kgDOCWv-Bg",
    "avatar_url": "https://avatars.githubusercontent.com/u/158072326?v=4",
    "gravatar_id": "",
